# Use the ASP.NET Core runtime as the base image
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

# Use the .NET SDK for building
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy csproj files and restore dependencies
COPY src/RabbitMQTaskScheduler.Core/RabbitMQTaskScheduler.Core.csproj src/RabbitMQTaskScheduler.Core/
COPY src/RabbitMQTaskScheduler.Infrastructure/RabbitMQTaskScheduler.Infrastructure.csproj src/RabbitMQTaskScheduler.Infrastructure/
COPY src/RabbitMQTaskScheduler.Web/RabbitMQTaskScheduler.Web.csproj src/RabbitMQTaskScheduler.Web/

RUN dotnet restore src/RabbitMQTaskScheduler.Web/RabbitMQTaskScheduler.Web.csproj

# Copy all source files
COPY src/ src/

# Build the application
WORKDIR /src/src/RabbitMQTaskScheduler.Web
RUN dotnet build RabbitMQTaskScheduler.Web.csproj -c Release -o /app/build

# Publish the application
FROM build AS publish
RUN dotnet publish RabbitMQTaskScheduler.Web.csproj -c Release -o /app/publish /p:UseAppHost=false

# Final stage/image
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create a non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["dotnet", "RabbitMQTaskScheduler.Web.dll"]